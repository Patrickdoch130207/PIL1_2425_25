[32m +#Algorithme de matching[m
[32m +[m
[32m +def comparer_adresses(adresse1, adresse2):[m
[32m +    """ Vérifie si deux adresses appartiennent à la même ville/quartier """[m
[32m +    return adresse1.lower().strip() == adresse2.lower().strip()[m
[32m +[m
[32m +def calculer_distance_google(start_coords, end_coords):[m
[32m +    """ Utilise Google Maps API pour obtenir la distance routière. """[m
[32m +    directions = gmaps.directions(start_coords, end_coords, mode="driving")[m
[32m +    return directions[0]['legs'][0]['distance']['value'] / 1000 if directions else None[m
[32m +[m
[32m +def estimer_distance(adresse_depart, adresse_arrivee):[m
[32m +    """ Estime la distance si aucune coordonnée GPS n'est disponible """[m
[32m +    distances_connues = {[m
[32m +        ("Cotonou", "Abomey-Calavi"): 15,  [m
[32m +    }[m
[32m +    return distances_connues.get((adresse_depart, adresse_arrivee), 100)  # Valeur par défaut[m
