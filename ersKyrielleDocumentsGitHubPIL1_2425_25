[32m +def trouver_matching():[m
[32m +    demandes = DemandeTrajet.objects.filter(statut="en_attente")[m
[32m +    conducteurs = Trajet.objects.filter(sieges_dispo__gt=0)[m
[32m +[m
[32m +    correspondances = [][m
[32m +[m
[32m +    for demande in demandes:[m
[32m +        for trajet in conducteurs:[m
[32m +            # Vérification des dates et horaires[m
[32m +            if demande.date_depart == trajet.date_depart and demande.heure_depart == trajet.heure_depart:[m
[32m +                [m
[32m +                # Tentative de récupération des distances via Google Maps API[m
[32m +                if demande.latitude_depart and demande.longitude_depart and trajet.latitude_depart and trajet.longitude_depart:[m
[32m +                    distance = calculer_distance_google([m
[32m +                        f"{demande.latitude_depart}, {demande.longitude_depart}",[m
[32m +                        f"{trajet.latitude_depart}, {trajet.longitude_depart}"[m
[32m +                    )[m
[32m +                else:[m
[32m +                    distance = estimer_distance(demande.point_depart, trajet.point_depart)  # Distance approximative[m
[32m +[m
[32m +                if distance and distance < 10:  # Seuil de distance acceptable[m
[32m +                    score_matching = 100 - (distance * 5)  # Score basé sur la proximité[m
[32m +                    [m
[32m +                    # Vérification des préférences[m
[32m +                    for key in demande.preferences:[m
[32m +                        if trajet.preferences.get(key) != demande.preferences.get(key):[m
[32m +                            score_matching -= 10  # Pénalité si préférences incompatibles[m
[32m +                    [m
[32m +                    correspondances.append((demande, trajet, score_matching))[m
[32m +[m
[32m +    # Trier les correspondances par **score décroissant**[m
