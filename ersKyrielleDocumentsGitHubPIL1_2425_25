[32m +gmaps = googlemaps.Client(key=settings.GOOGLE_MAPS_API_KEY)[m
[32m +[m
[32m +def obtenir_coordonnees(adresse):[m
[32m +    """ Convertit une adresse en coordonnées GPS via Google Maps API """[m
[32m +    geocode_result = gmaps.geocode(adresse)[m
[32m +    if geocode_result:[m
[32m +        location = geocode_result[0]['geometry']['location'][m
[32m +        return location['lat'], location['lng'][m
[32m +    return None, None[m
